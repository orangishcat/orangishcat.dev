---
import MetaHead from "../components/MetaHead.astro";
import Banner from "../components/Banner.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <MetaHead />
    <title>{(title ? `${title} | ` : "") + "orangishcat's happy place"}</title>
  </head>
  <body>
    <main
      class="hidden sm:block mx-auto px-16 pt-20 pb-44 min-h-screen justify-center place-items-center ml-1 relative"
    >
      <slot />
      <div
        class="absolute text-center bottom-0 left-0 w-full pt-12 pb-6 text-gray-400 bg-linear-to-b from-transparent to-black/80"
      >
        Made with <span class="text-red-400">&lt;3</span> by <span
          class="text-primary">orangishcat</span
        >. © 2026 orangishcat. All rights reserved.
      </div>
    </main>
    <div class="sm:hidden flex flex-col p-4 justify-center place-items-center">
      <Banner />
      turn your phone horizontally pls! this site is not very mobile friendly
    </div>
  </body>
</html>
