---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import Links from "../components/Links.astro";
import A from "../components/Anchor.astro";
import { coloredDate, projects } from "../data.ts";
---

<Layout title="Projects">
  <div class="w-full h-full max-w-4xl mx-auto">
    <Banner />
    <div
      class="grid grid-cols-[4fr_1fr] content-stretch justify-items-stretch gap-4 rounded-2xl mb-12"
    >
      <!-- First column -->
      <div class="border border-gray-600 bg-background/80">
        <h1 class="text-center text-5xl! mt-4!">Projects</h1>
        <div class="flex justify-center mb-4 text-gray-300 text-sm">
          <div class="w-1/2 text-center">
            They're not sorted by date, rather they're sorted by how proud I am
            of each one
          </div>
        </div>
        <div
          class="[&>a>div]:border-t [&>a>div]:border-gray-700 [&>a>div]:border-b"
        >
          {
            projects.map((obj) => (
              <A
                href={obj.url}
                class="hover:no-underline! hover:brightness-100!"
              >
                <div class="hover:bg-background-light px-6 pt-3 pb-4">
                  <h3 class="text-[1.75rem]!">
                    {obj.title}{" "}
                    {obj.note && (
                      <span class="text-gray-400 ml-1 text-2xl">
                        ({obj.note})
                      </span>
                    )}
                  </h3>
                  <div class="text-[0.95rem] text-gray-200 mb-1.5">
                    <div
                      class="text-sm text-gray-400 mb-2"
                      set:html={coloredDate(obj.datePublished)}
                    />
                    {obj.description}
                  </div>
                </div>
              </A>
            ))
          }
        </div>
      </div>
      <div>
        <!-- Second column -->
        <Links />
      </div>
    </div>
  </div>
</Layout>
