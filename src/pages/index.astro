---
import Img from "../components/Img.astro";
import plantImage from "../assets/plant.avif";
import githubImage from "../assets/socials icons/github.avif";
import redditImage from "../assets/socials icons/reddit.avif";
import neocitiesImage from "../assets/socials icons/neocities.avif";
import clockImage from "../assets/clock.apng";
import bookImage from "../assets/book.apng";
import minecraftImage from "../assets/game icons/minecraft.avif";
import osuImage from "../assets/game icons/osu.avif";
import geometryDashImage from "../assets/game icons/geometry dash.avif";
import ttcImage from "../assets/game icons/ttc.avif";
import deltaruneImage from "../assets/game icons/deltarune.avif";
import undertaleImage from "../assets/game icons/undertale.avif";
import estellaImage from "../assets/game icons/estella.avif";
import undertaleYellowImage from "../assets/game icons/undertale yellow.avif";
import celesteImage from "../assets/game icons/celeste.avif";
import oneshotImage from "../assets/game icons/oneshot.avif";
import omoriImage from "../assets/game icons/omori.avif";
import rainWorldImage from "../assets/game icons/rain world.avif";
import hollowKnightImage from "../assets/game icons/hollow knight.avif";
import silksongImage from "../assets/game icons/silksong.avif";
import unbeatableImage from "../assets/game icons/unbeatable.avif";
import computerImage from "../assets/computer.avif";
import gameplay from "../assets/gameplay.webm?url";
import Layout from "../layouts/Layout.astro";
import A from "../components/Anchor.astro";
import Banner from "../components/Banner.astro";
import Links from "../components/Links.astro";
import { projects, blogs } from "../data.ts";
---

<Layout>
  <div class="w-full h-full max-w-6xl mx-auto">
    <Banner />
    <div
      class="grid grid-cols-[1fr_3fr_1fr] content-stretch justify-items-stretch gap-4 rounded-2xl mb-12"
    >
      <!-- First column -->
      <div class="flex flex-col [&>div]:py-2 text-center relative">
        <Img src={plantImage} class="-mb-1.5 z-10 w-full" />
        <div class="flex flex-col border border-gray-600 bg-background/80">
          <h2 class="border-b border-gray-600">Socials</h2>
          <div
            class="text-left space-y-2 [&>a]:block mx-auto [&>a>div]:flex [&>a>div]:gap-2 [&>a>div]:place-items-center [&>a>div>img]:w-6 py-2"
          >
            <A href="https://github.com/orangishcat">
              <div>
                <Img src={githubImage} />
                <div>GitHub</div>
              </div>
            </A>
            <A href="https://www.reddit.com/user/Safe_Paper_9540/">
              <div>
                <Img src={redditImage} />
                <div>Reddit</div>
              </div>
            </A>
            <A href="https://neocities.org/site/orangishcat">
              <div>
                <Img src={neocitiesImage} />
                <div>Neocities</div>
              </div>
            </A>
          </div>
        </div>
        <div class="my-8"></div>
        <Img src={clockImage} class="w-1/2 mx-auto -mb-0.5 z-10" />
        <div class="border border-gray-600 bg-background/80 p-0!">
          <h2 class="mt-2">Projects</h2>
          <div class="text-left [&>a>div]:border-t [&>a>div]:border-gray-600">
            {
              projects.map((obj) => (
                <A
                  href={obj.url}
                  class="hover:no-underline! hover:brightness-100!"
                >
                  <div class="hover:bg-background-light text-xs px-2 pt-1 pb-2 group transition-colors duration-400">
                    <h3 class="text-[1.35rem]!">{obj.title} </h3>
                    {obj.note && (
                      <div class="mb-1 text-sm text-gray-300">({obj.note})</div>
                    )}
                    <div class="text-[0.75rem] line-clamp-2 group-hover:line-clamp-none max-h-12 group-hover:max-h-60 transition-colors duration-400 ease-in-out text-gray-400 group-hover:text-white">
                      {obj.description}
                    </div>
                  </div>
                </A>
              ))
            }
          </div>
        </div>
        <br />
        <A
          href="/blog/personal-website"
          class="absolute bottom-8 hover:scale-130 transition"
        >
          <Img src={bookImage} />
        </A>
        <br />
      </div>

      <!-- Second column -->
      <div
        class="border-gray-600 border space-y-6 p-4 bg-background/80 content-area"
      >
        <div>
          <h2>About me</h2>
          <p>
            <span class="text-lg">Hi hi!</span><br />
            I'm a <ac>high school programmer</ac> who occasionally codes random stuff!
            <br />
          </p>
          <p>
            I post my projects, blog posts, and devlogs on this website. This
            site is just my little corner of the internet :D
          </p>
          <p>
            I'm definitely not a great artist, but I try out art sometimes just
            for fun!
          </p>
          <p>
            Some facts about me:
            <ul>
              <li>I live in <ac>California, USA</ac>!</li>
              <li>I like cats! (obviously)</li>
              <li>I like the outdoors too!</li>
              <li>I'm a night owl. My sleep schedule is utterly terrible.</li>
              <li>
                I don't really have a favorite color, but if you asked me I
                would probably say <span class="text-primary">orange</span>.
              </li>
              <li>
                <A href="/about-me">More about me</A>
              </li>
            </ul>
          </p>
        </div>
        <div>
          <h2>Programming skillset</h2>
          <p>
            I specialize mostly in <ac>webdev</ac> and <ac>Minecraft modding</ac
            >, and I know a lot about <ac>Python</ac> and have used it for robotics
            and data science.
          </p>
          <p>
            I also recently learned Rust and made my <A
              href="https://github.com/orangishcat/cursed-tetris"
              >first Rust project</A
            >!
          </p>
          <p>
            I have worked with <ac>C++</ac> for robotics before, but I usually don't
            focus much on low-level development though as manual memory management
            is a pain.
          </p>
        </div>
        <div>
          <h2>Hobbies</h2>
          <ul>
            <li><ac>Programming</ac>!</li>
            <li>
              <ac>Running</ac>. It's good exercise that I can do fully by
              myself, and I can explore the outdoors!
            </li>
            <li>
              <ac>Hiking</ac>. I like nature and the outdoors, and exploring it.
            </li>
            <li>
              <ac>Piano</ac>. I used to take classes but then got bored. I now
              practice occasionally by myself.
            </li>
            <li>
              <ac>Video games</ac>!
            </li>
          </ul>
        </div>
        <div>
          <h2>Want to learn</h2>
          <p>
            Haven't done much hardware outside of robotics, and I try out art
            for fun sometimes, like for making this website! I hope to improve
            at both someday :)
          </p>
          <p>
            And I might want to try composing music? I'm not very good at it
            though...
          </p>
        </div>
        <h2>Games</h2>
        <p>
          I like:
          <ul>
            <li>
              Indie games, especially those with good music and storylines!
            </li>
            <li>Rhythm games!</li>
            <li>
              And Minecraft, it's the game I grew up on and you can do just
              about anything in it :D
            </li>
          </ul>
        </p>
        <div
          class="space-y-6
              [&>div>div]:grid [&>div>div]:grid-cols-5 [&>div>div]:content-stretch
              [&>div>div]:gap-3"
        >
          <div>
            <h3>Games I like</h3>
            <div>
              <A href="https://www.minecraft.net/en-us">
                <Img src={minecraftImage} />
              </A>
              <A href="https://osu.ppy.sh/">
                <Img src={osuImage} />
              </A>
              <A href="https://geometrydash.com/">
                <Img src={geometryDashImage} />
              </A>
              <A
                href="https://store.steampowered.com/app/1660910/Tanks_The_Crusades/"
              >
                <Img src={ttcImage} />
              </A>
            </div>
          </div>
          <div>
            <h3>Games I play occasionally</h3>
            <div>
              <A href="https://deltarune.com/">
                <Img src={deltaruneImage} />
              </A>
              <A href="https://undertale.com/">
                <Img src={undertaleImage} />
              </A>
              <A href="https://estella.studio/">
                <Img src={estellaImage} />
              </A>
              <A href="https://undertaleyellow.com/">
                <Img src={undertaleYellowImage} />
              </A>
            </div>
          </div>
          <div>
            <h3>Games I want to try</h3>
            <div>
              <A href="https://www.celestegame.com/">
                <Img src={celesteImage} />
              </A>
              <A href="http://oneshot-game.com/">
                <Img src={oneshotImage} />
              </A>
              <A href="https://www.omori-game.com/">
                <Img src={omoriImage} />
              </A>
              <A href="https://rainworldgame.com/">
                <Img src={rainWorldImage} />
              </A>
              <A href="https://hollowknight.com/">
                <Img src={hollowKnightImage} />
              </A>
              <A href="https://hollowknightsilksong.com/">
                <Img src={silksongImage} />
              </A>
              <A href="https://www.unbeatablegame.com/">
                <Img src={unbeatableImage} />
              </A>
            </div>
            <p>Lots of cool games out there!</p>
          </div>
        </div>
        <div>
          <h2>The end</h2>
          <p>
            Thank you for making it to the end! Hope you have a nice day <span
              class="text-red-400">&lt;3</span
            >
          </p>
        </div>
      </div>

      <!-- Third column -->
      <div class="text-center relative">
        <Links />
        <div class="py-8"></div>
        <div class="border-gray-600 border pt-2 bg-background/80">
          <h2>Blog</h2>
          <div class="[&>a>div]:border-t [&>a>div]:border-gray-600 text-left">
            {
              blogs.map((obj) => (
                <A
                  href={`/blog/${obj.slug}`}
                  class="hover:no-underline! hover:brightness-100!"
                >
                  <div class="p-2 group hover:bg-background-light transition-colors duration-400">
                    <h3 class="text-[1.15rem]! line-clamp-2 group-hover:line-clamp-none w-full leading-5">
                      {obj.title}
                    </h3>
                    <div class="mb-1 text-sm text-gray-300">({obj.date})</div>
                    <div class="text-[0.75rem] line-clamp-2 group-hover:line-clamp-none max-h-12 group-hover:max-h-60 transition-colors duration-400 ease-in-out text-gray-400 group-hover:text-white">
                      {obj.description}
                    </div>
                  </div>
                </A>
              ))
            }
          </div>
        </div>
        <br />
        <br />
        <div class="absolute bottom-20 right-0 w-full">
          <div class="w-full relative">
            <Img src={computerImage} class="w-full" />
            <video
              autoplay
              muted
              playsinline
              class="absolute top-[22%] left-[25%] w-[58%]"
            >
              <source src={gameplay} type="video/webm" /></video
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
